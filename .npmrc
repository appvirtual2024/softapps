# pnpm crea por defecto un node_modules estricto (sin dependencias fantasma).
# Algunas herramientas de build (Vite, plugins) a veces esperan resolución "flat"
# como la de npm; esta línea evita falsos errores de "module not found" sin
# perder el resto de las ventajas de pnpm.
shamefully-hoist=false
strict-peer-dependencies=false
